# Affiliate Post Monitor - environment template
# Copy to .env for the backend:   cp .env.example backend/.env

# Your Amazon Associates tracking tag (e.g. "mysite-20", "mysite-21")
AMAZON_ASSOCIATE_TAG=laique248-20

# Where the SQLite DB file lives. Relative paths resolve from backend/.
DATABASE_URL=sqlite:///./data/app.db

# Bind host/port for FastAPI
HOST=0.0.0.0
PORT=8000

# Scan scheduler defaults (can also be changed from app Settings)
SCAN_INTERVAL_MINUTES=60
DAILY_IMPORT_LIMIT=100
DELAY_BETWEEN_PAGE_SCANS_SECONDS=5

# When true, no real HTTP requests are made. Scans use bundled sample_data/.
# Useful for local dev and for the APK's "Test mode" toggle.
TEST_MODE=false

# Enable Playwright fallback when simple HTML parsing fails.
# Requires `playwright install chromium` after installing requirements.
ENABLE_PLAYWRIGHT_FALLBACK=false

# User-Agent used for public page fetches
USER_AGENT=Mozilla/5.0 (compatible; AffiliatePostMonitor/1.0; +https://example.com/bot)

# CORS origins (comma-separated). Use * for open access in local dev.
CORS_ORIGINS=*
